# Example secrets.toml for local development
# Copy this file to secrets.toml and fill in your actual credentials
# DO NOT commit secrets.toml to version control

# For local development, you can either:
# 1. Use Data/credentials.json (default - no need for this file)
# 2. Or uncomment and fill in the line below:

# GOOGLE_CREDENTIALS = '{"type": "service_account", "project_id": "your-project-id", ...}'