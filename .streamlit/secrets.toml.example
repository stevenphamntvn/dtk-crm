# Example secrets.toml for Streamlit Cloud deployment
# Paste into Streamlit Cloud -> App Settings -> Secrets

# 1. Google Sheets Credentials (JSON String)
# GOOGLE_CREDENTIALS = '{"type": "service_account", "project_id": "...", ...}'

# 2. Login Credentials (Required for Cloud Access)
# Option A - Multi-user:
[users]
admin = "dtk@2025"
# advisor1 = "dtk@advisor1"

# Option B - Single user:
# APP_USERNAME = "admin"
# APP_PASSWORD = "your_secure_password"
